{
  "name": "hostelbite-server",
  "version": "1.0.0",
  "description": "Backend API for HostelBite - Hostel Food Delivery Application",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node ./node_modules/tsx/dist/cli.mjs src/server.ts",
    "seed": "node ./node_modules/tsx/dist/cli.mjs src/db/seed.ts",
    "test": "node ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
